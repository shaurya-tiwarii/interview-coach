# Copy to .env (never commit a real key). The backend reads GEMINI_API_KEY
# ONLY from the environment. It is never hardcoded anywhere in the code.
GEMINI_API_KEY=
# Optional overrides:
# WHISPER_MODEL=base
# TOTAL_TURNS=5
# INTERVIEW_COACH_DB=/path/to/interview_coach.db
# COOKIE_SECURE=1   # set in production (HTTPS) so the session cookie is Secure
